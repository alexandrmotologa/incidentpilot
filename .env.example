# IncidentPilot Configuration
INCIDENTPILOT_HOST=0.0.0.0
INCIDENTPILOT_PORT=8080
INCIDENTPILOT_DB_PATH=./data/incidentpilot.db
INCIDENTPILOT_INVESTIGATION_TIMEOUT_SECONDS=55
INCIDENTPILOT_LOG_WINDOW_MINUTES=15
INCIDENTPILOT_DEDUP_WINDOW_SECONDS=300

# Webhook Signature Verification (optional in local dev, recommended in production)
INCIDENTPILOT_PAGERDUTY_WEBHOOK_SECRET=
INCIDENTPILOT_SENTRY_CLIENT_SECRET=
INCIDENTPILOT_ALERTMANAGER_BEARER_TOKEN=

# Log Provider: "jsonl" | "loki" | "http"
INCIDENTPILOT_LOG_PROVIDER=jsonl
INCIDENTPILOT_LOG_FILE_PATH=./data/service.log.jsonl
INCIDENTPILOT_LOKI_URL=http://localhost:3100
INCIDENTPILOT_HTTP_LOG_URL=

# Git & Deployment Provider: "local" | "github"
INCIDENTPILOT_GIT_PROVIDER=local
INCIDENTPILOT_LOCAL_REPO_PATH=.
INCIDENTPILOT_GITHUB_TOKEN=
INCIDENTPILOT_GITHUB_REPO=
INCIDENTPILOT_GIT_LOOKBACK_HOURS=48

# Optional LLM Synthesis (OpenAI-compatible endpoint; falls back to deterministic evidence synthesis if empty)
INCIDENTPILOT_LLM_API_URL=https://api.openai.com/v1/chat/completions
INCIDENTPILOT_LLM_API_KEY=
INCIDENTPILOT_LLM_MODEL=gpt-4o-mini

# Slack Integration
INCIDENTPILOT_SLACK_WEBHOOK_URL=
INCIDENTPILOT_SLACK_BOT_TOKEN=
INCIDENTPILOT_SLACK_CHANNEL=
INCIDENTPILOT_SLACK_SIGNING_SECRET=

# Rollback Executor: "local_git" | "github_workflow" | "webhook"
INCIDENTPILOT_ROLLBACK_PROVIDER=local_git
INCIDENTPILOT_ROLLBACK_WEBHOOK_URL=
INCIDENTPILOT_ROLLBACK_WEBHOOK_SECRET=
INCIDENTPILOT_GITHUB_ROLLBACK_WORKFLOW=rollback.yml
INCIDENTPILOT_ROLLBACK_COMMAND=
